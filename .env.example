# ─── Anthropic ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ─── GitHub (for Acentecom/product-configs) ─────────────────────────────
GITHUB_TOKEN=
PRODUCT_CONFIGS_OWNER=Acentecom
PRODUCT_CONFIGS_REPO=product-configs
PRODUCT_CONFIGS_BRANCH=main
# Optional — point at a local checkout to bypass GitHub during offline dev.
LOCAL_PRODUCT_CONFIGS_PATH=

# ─── Supabase ────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used by drizzle-kit (Postgres connection string).
SUPABASE_DB_URL=

# ─── Nano Banana Pro (image generation) ─────────────────────────────────
NANO_BANANA_PRO_API_KEY=
NANO_BANANA_PRO_BASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────
# Shared password for all @acentecom.com users. Matches NEW-UGC-Scripts.
SHARED_PASSWORD=Acent123

# ─── Tool VPS (this app's own host) ─────────────────────────────────────
VPS_DEV_HOST=
VPS_DEV_USER=root
VPS_DEV_SSH_KEY_PATH=

# ─── Landers VPS (dedicated, for publishing static landers) ─────────────
VPS_LANDERS_HOST=187.77.29.59
VPS_LANDERS_USER=root
VPS_LANDERS_ROOT_PASSWORD=
VPS_LANDERS_SSH_KEY_PATH=

# ─── Server ──────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Feature flags ──────────────────────────────────────────────────────
# Set to 1 to expose the _placeholder template in the user-facing template
# selector. Default off — _placeholder is engine-test scaffolding only.
ENABLE_PLACEHOLDER_TEMPLATE=0
