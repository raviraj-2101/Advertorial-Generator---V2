# nginx-landers.conf.template
#
# Per-domain nginx server block for the landers VPS (187.77.29.59).
# Each published domain gets one of these, generated by
# `deploy/provision-domain.sh <domain>` and dropped into
# `/etc/nginx/sites-available/<domain>.conf` then symlinked into
# `sites-enabled/`. Run `nginx -t && systemctl reload nginx` to apply.
#
# Substitution variables:
#   ${DOMAIN}     — the fully-qualified domain (no protocol, no trailing slash)
#   ${DOCROOT}    — typically /var/www/landers/${DOMAIN}
#   ${LE_PATH}    — path to the Let's Encrypt live certificate directory

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Let's Encrypt http-01 challenge — keep this accessible even when
    # everything else is forced to HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    # Force HTTPS for everything else.
    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN};

    ssl_certificate     ${LE_PATH}/fullchain.pem;
    ssl_certificate_key ${LE_PATH}/privkey.pem;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    root ${DOCROOT};
    index index.html;

    # Static-only. The advertorials-generator's publishing route SCP's
    # rendered HTML + assets into ${DOCROOT}/<path>/index.html. nginx
    # serves them as plain static files.
    location / {
        try_files $uri $uri/ $uri/index.html =404;
        add_header Cache-Control "public, max-age=300";
    }

    # Long-cache images and font files.
    location ~* \.(jpg|jpeg|png|webp|avif|svg|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
    }

    access_log /var/log/nginx/${DOMAIN}.access.log;
    error_log  /var/log/nginx/${DOMAIN}.error.log;
}
